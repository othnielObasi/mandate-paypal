# Everything is optional: with nothing set, Mandate runs fully offline with
# simulated payments and a deterministic planner, so you can try it in 1 minute.

# Public URL of this app (used for PayPal return/cancel links)
APP_URL=http://localhost:3000

# PayPal sandbox app credentials (developer.paypal.com > Apps & Credentials > Sandbox).
# When set, payments go through the official PayPal Agent Toolkit. Sandbox only.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=SANDBOX

# PayPal webhook id (developer.paypal.com > your sandbox app > Webhooks), for
# https://<your-app>/api/paypal/webhooks with events CHECKOUT.ORDER.APPROVED and
# CUSTOMER.DISPUTE.CREATED / UPDATED / RESOLVED. Unset = webhooks refused.
PAYPAL_WEBHOOK_ID=

# The model that drives the agent, reads the rules and drafts disputes. Either:
#  - Muse Spark on the Meta Model API (dev.meta.ai): MODEL_API_KEY. US regions; it lists no models from EU servers.
#  - Claude (console.anthropic.com): ANTHROPIC_API_KEY.
# MANDATE_LLM=meta|claude picks one; unset = whichever key is set (Claude first). Neither = an offline planner.
MANDATE_LLM=
MODEL_API_KEY=
ANTHROPIC_API_KEY=
# muse-spark-1.3 (default for meta), muse-wonder-1.0, or claude-sonnet-5-5 (default for claude)
MANDATE_MODEL=

# Postgres connection string. Unset = in-memory (data resets on restart).
# With a database, MANDATE_SIGNING_KEY is required.
DATABASE_URL=

# Ed25519 private key (PKCS#8 PEM) for signing permits and receipts.
# Generate: node -e "console.log(require('crypto').generateKeyPairSync('ed25519').privateKey.export({type:'pkcs8',format:'pem'}))"
# Unset = a new key on every restart (receipts from earlier runs won't verify).
MANDATE_SIGNING_KEY=

# Limits on routes that call the model (per client IP, and across everyone).
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_HOUR=300
# Proxies in front of the app (Render: 1). Used to find the real client IP.
TRUSTED_PROXY_HOPS=1

# Simulated payments only: "payer_action" mimics PayPal's buyer-approval redirect.
MANDATE_SIMULATED_MODE=

# Channel3 API key for real market prices (free key at trychannel3.com).
# Unset = a clearly labelled simulated market for the demo catalogue.
CHANNEL3_API_KEY=

# Extra browser origins allowed to call the MCP endpoint (comma-separated).
MCP_ALLOWED_ORIGINS=

# Zapier alerts: a "Webhooks by Zapier > Catch Hook" URL. Mandate posts approval requests,
# blocked purchases, payments and pauses to it, for your Zap to text, email or Slack you.
ZAPIER_HOOK_URL=
# Zapier kill switch: a Zap can POST /api/automation/kill-switch with this as a Bearer token
# to pause, resume or revoke spending. 16+ characters. Unset = kill switch off.
AUTOMATION_SECRET=

# KERNEL cloud browsers (kernel.sh): the agent can read any public web page, always as untrusted
# content. Unset = the agent can read only this app's own /demo pages.
KERNEL_API_KEY=

# AG Studio (the Insights dashboard) licence key. Client-side by design; set it before building.
# Unset = AG Studio shows its evaluation watermark.
NEXT_PUBLIC_AG_STUDIO_LICENSE_KEY=

# APIMatic (optional, dev only): validate the OpenAPI spec and regenerate SDKs (npm run api:validate / sdk:generate)
APIMATIC_API_KEY=
