# Everything is optional: with nothing set, Mandate runs fully offline with
# simulated payments and a deterministic planner, so you can try it in 1 minute.

# Public URL of this app (used for PayPal return/cancel links)
APP_URL=http://localhost:3000

# PayPal sandbox app credentials (developer.paypal.com > Apps & Credentials > Sandbox).
# When set, payments go through the official PayPal Agent Toolkit. Sandbox only.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=SANDBOX

# PayPal webhook id (developer.paypal.com > your sandbox app > Webhooks), for
# https://<your-app>/api/paypal/webhooks with events CHECKOUT.ORDER.APPROVED and
# CUSTOMER.DISPUTE.CREATED / UPDATED / RESOLVED. Unset = webhooks refused.
PAYPAL_WEBHOOK_ID=

# Claude API key. When set, Claude drives the agent and parses mandates.
ANTHROPIC_API_KEY=
MANDATE_MODEL=claude-sonnet-5-5

# Postgres connection string. Unset = in-memory (data resets on restart).
# With a database, MANDATE_SIGNING_KEY is required.
DATABASE_URL=

# Ed25519 private key (PKCS#8 PEM) for signing permits and receipts.
# Generate: node -e "console.log(require('crypto').generateKeyPairSync('ed25519').privateKey.export({type:'pkcs8',format:'pem'}))"
# Unset = a new key on every restart (receipts from earlier runs won't verify).
MANDATE_SIGNING_KEY=

# Limits on routes that call the model (per client IP, and across everyone).
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_HOUR=300
# Proxies in front of the app (Render: 1). Used to find the real client IP.
TRUSTED_PROXY_HOPS=1

# Simulated payments only: "payer_action" mimics PayPal's buyer-approval redirect.
MANDATE_SIMULATED_MODE=
