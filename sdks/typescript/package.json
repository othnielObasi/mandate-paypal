{
  "name": "mandate-api",
  "version": "0.2.0",
  "description": "Mandate is an authorisation layer for AI-agent payments on PayPal. Every agent payment carries\nAP2 v0.2 mandates (the customer's signed limits, the merchant's signed checkout, the agent's closed\nmandates) and signed receipts. The **Verification** endpoints let a seller, PayPal or a dispute\nreviewer check a payment with public keys alone. The **Demo** endpoints drive the same flow the app\nuses: sign rules, let the agent shop, approve over-limit purchases.\n\nSandbox only. No real money moves. Without keys the server runs fully offline with simulated\nPayPal order IDs (`SIM-…`); with PayPal sandbox keys the IDs are real sandbox order IDs.\n",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/commonjs/index.d.ts",
        "default": "./dist/commonjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "tshy": {
    "exports": {
      ".": "./src/index.ts",
      "./package.json": "./package.json"
    },
    "dialects": [
      "esm",
      "commonjs"
    ],
    "project": "./tsconfig.tshy.json",
    "selfLink": false
  },
  "main": "./dist/commonjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/commonjs/index.d.ts",
  "files": [
    "dist",
    "src",
    "tsconfig.json",
    "tsconfig.tshy.json",
    "README.md",
    "api-reference.md",
    "sdk-map.md",
    "map"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.3"
  },
  "scripts": {
    "prepare": "tshy",
    "build": "tshy",
    "smoke": "node -e \"require('mandate-api')\" && node --input-type=module -e \"import('mandate-api')\"",
    "typecheck": "tsc --noEmit",
    "typecheck:dom": "tsc --noEmit -p tsconfig.dom.json",
    "lint": "oxlint --type-aware --max-warnings=0 src",
    "format": "oxfmt src",
    "format:check": "oxfmt --check src"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.14.0",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tshy": "^4.1.3",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "zod": "^4.1.0"
  }
}
