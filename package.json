{
  "name": "mandate",
  "version": "0.1.0",
  "private": true,
  "description": "Mandate: a governed buying agent on PayPal. The agent shops; a deterministic policy gate decides; only a permit-holding executor can move money.",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "api:validate": "node scripts/apimatic.mjs validate",
    "sdk:generate": "node scripts/apimatic.mjs sdk",
    "docs:generate": "node scripts/apimatic.mjs portal",
    "plugin:generate": "node scripts/apimatic.mjs plugin",
    "pretest": "npm --prefix sdks/typescript install --omit=dev --ignore-scripts --no-audit --no-fund --silent"
  },
  "dependencies": {
    "@bryntum/calendar-community": "^8.0.0",
    "@bryntum/calendar-react-community": "^8.0.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "@noble/curves": "^1.8.1",
    "@noble/hashes": "^1.7.1",
    "@onkernel/sdk": "0.127.0",
    "@paypal/agent-toolkit": "1.11.0",
    "@paypal/paypal-server-sdk": "2.5.0",
    "ag-grid-community": "^33.3.2",
    "ag-grid-react": "^33.3.2",
    "ag-studio": "3.0.0",
    "ag-studio-react": "3.0.0",
    "ai": "^4.3.19",
    "next": "15.5.28",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "^0.3.16",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "fast-check": "^3.0.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
